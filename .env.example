# -----------------------------------------------------------------------------
# Al Baraka Showroom — environment variables
# Copy this file to `.env.local` and fill in the real values.
# Never commit `.env.local`.
# -----------------------------------------------------------------------------

# Supabase (Project Settings → Data API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Cloudinary (Dashboard → Programmable Media → Dashboard)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Note:
# - Only the publishable/cloud-name values belong in the Vite client.
# - Cloudinary API secret and Supabase secret/service-role keys must never be
#   placed in Vite variables or committed to this repository.
