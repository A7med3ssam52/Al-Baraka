# -----------------------------------------------------------------------------
# Al Baraka Showroom — environment variables
# Copy this file to `.env.local` and fill in the real values.
# Never commit `.env.local`.
# -----------------------------------------------------------------------------

# Supabase (Project Settings → Data API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Cloudinary (Dashboard → Programmable Media → Dashboard)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# CLI-only variables for local Supabase operations (never prefix with VITE_).
# Leave them commented unless you are applying migrations from this machine.
# SUPABASE_ACCESS_TOKEN=your-new-personal-access-token
# SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Local test user credentials (never prefix with VITE_ and never commit .env.local).
# TEST_USER_EMAIL=test@example.com
# TEST_USER_PASSWORD=change-me

# Note:
# - Only the publishable/cloud-name values belong in the Vite client.
# - Cloudinary API secret and Supabase secret/service-role keys must never be
#   placed in Vite variables or committed to this repository.
